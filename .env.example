# Hermes Agent Environment for Render
# Secrets are set via Render dashboard, not in this file

# Telegram Bot
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_ALLOWED_USERS=5789631016

# Telegram Webhook (required for cloud deployment)
# Set TELEGRAM_WEBHOOK_URL to: https://hermes-render.onrender.com/telegram
# Set TELEGRAM_WEBHOOK_SECRET to a random hex string (generate with: openssl rand -hex 32)
TELEGRAM_WEBHOOK_URL=${TELEGRAM_WEBHOOK_URL}
TELEGRAM_WEBHOOK_SECRET=${TELEGRAM_WEBHOOK_SECRET}
TELEGRAM_WEBHOOK_PORT=8443

# VansRouter connection
VANSROUTER_URL=${VANSROUTER_URL}
VANSROUTER_API_KEY=59892d6855594d25f267bbdf8b3f87ed64626907f374a70cd7716c781e660276

# Hermes
HERMES_HOME=/opt/data
API_SERVER_KEY=hermes-render-key-2026
